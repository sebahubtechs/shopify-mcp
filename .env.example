# Client credentials: app must belong to the store's merchant organization.
MYSHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Required for all remote requests. Generate privately; never commit a real key.
MCP_API_KEY=
REMOTE_MCP=true
# SHOPIFY_MCP_READ_ONLY=true
# PORT=3000
# MCP_ALLOWED_ORIGINS=https://client.example
# MCP_ALLOWED_HOSTS=mcp.example.com
# SHOPIFY_API_VERSION=2026-10
# Local stdio only: REMOTE_MCP=false permits legacy OAuth/static-token support.
# Never configure SHOPIFY_ACCESS_TOKEN on the production remote service.
