{
  "name": "@benwmerritt/shopify-mcp",
  "version": "2.0.0",
  "description": "MCP Server for Shopify API, enabling interaction with store data through GraphQL API",
  "main": "dist/index.js",
  "bin": {
    "shopify-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "start:local": "node dist/index.js",
    "start:remote": "node dist/index.js --remote",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "lint": "eslint 'src/**/*.ts'",
    "clean": "rimraf dist",
    "test:connections": "npm run build && node --test __tests__/protocol.integration.mjs",
    "schema:check": "npm run build && node scripts/check-schema.mjs",
    "tools:catalog": "npm run build && node scripts/tool-catalog.mjs",
    "verify:remote": "node scripts/verify-remote.mjs"
  },
  "keywords": [
    "shopify",
    "mcp",
    "model-context-protocol",
    "graphql",
    "ai",
    "llm",
    "claude"
  ],
  "author": {
    "name": "Ben Merritt",
    "url": "https://github.com/benwmerritt"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/server-legacy": "2.4.0",
    "dotenv": "16.4.7",
    "express": "5.2.1",
    "graphql": "16.10.0",
    "graphql-request": "5.2.0",
    "minimist": "1.2.8",
    "multer": "2.4.0",
    "open": "10.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/minimist": "1.2.5",
    "@types/multer": "2.1.0",
    "@types/node": "20.19.43",
    "jest": "29.7.0",
    "rimraf": "5.0.10",
    "ts-jest": "29.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.8.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebahubtechs/shopify-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sebahubtechs/shopify-mcp/issues"
  },
  "homepage": "https://github.com/sebahubtechs/shopify-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
