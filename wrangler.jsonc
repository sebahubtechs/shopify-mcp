{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skunkfly-team-mcp",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "build": {"command": "npm run build"},
  "rules": [{"type":"Text","globs":["**/*.graphql"],"fallthrough":true}],
  "vars": {
    "NODE_ENV":"production",
    "REMOTE_MCP":"true",
    "SHOPIFY_MCP_WORKER":"true",
    "PORT":"3000",
    "SHOPIFY_API_VERSION":"2026-10",
    "SHOPIFY_FILE_UPLOAD_MAX_BYTES":"10485760"
  },
  "durable_objects":{"bindings":[{"name":"SHOPIFY_MCP_HOST","class_name":"ShopifyMcpHost"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ShopifyMcpHost"]}],
  "observability":{"enabled":false}
}
